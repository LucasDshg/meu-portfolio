{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/u/lucas-gomes"
    },
    {
      "source": "/_next/:path*|/assets/:path*|/static/:path*|/favicon.ico|/logo-CuGCXOrl.svg",
      "destination": "/$0"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
