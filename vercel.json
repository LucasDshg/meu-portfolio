{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/u/:slug/articles/:articleSlug",
      "destination": "/api/article-preview?slug=:slug&articleSlug=:articleSlug"
    },
    {
      "source": "/((?!api/|assets/|ads.txt|favicon.ico|logo.svg|logo-CuGCXOrl.svg).*)",
      "destination": "/index.html"
    }
  ]
}
